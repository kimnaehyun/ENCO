pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        WEB_DEPLOY_PATH = '/var/www/enco-shoppingmall'
        NOTIFY_WEBHOOK = credentials('mattermost-webhook')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Shoppingmall Dir') {
            steps {
                sh '''
                echo "===== ROOT ====="
                pwd
                ls -al
                echo "===== enco-shopping-mall/ut-hyeyeok ====="
                ls -al enco-shopping-mall/ut-hyeyeok
                '''
            }
        }

        stage('Build Shoppingmall Web') {
            steps {
                dir('enco-shopping-mall/ut-hyeyeok') {
                    sh '''
                    node --version
                    npm --version
                    npm ci
                    npm run build
                    '''
                }
            }
        }

        stage('Deploy Shoppingmall Web') {
            steps {
                sh '''
                mkdir -p ${WEB_DEPLOY_PATH}
                rm -rf ${WEB_DEPLOY_PATH:?}/*
                cp -r enco-shopping-mall/ut-hyeyeok/dist/* ${WEB_DEPLOY_PATH}/
                '''
            }
        }
    }

    post {
        success {
            sh '''
            cat > payload.json <<EOF
    {"text":"✅ 쇼핑몰 웹 배포 성공: ${JOB_NAME} #${BUILD_NUMBER}"}
    EOF
            curl -X POST -H "Content-Type: application/json" --data @payload.json "$NOTIFY_WEBHOOK"
            '''
        }
        failure {
            sh '''
            cat > payload.json <<EOF
    {"text":"❌ 쇼핑몰 웹 배포 실패: ${JOB_NAME} #${BUILD_NUMBER}\\n로그: ${BUILD_URL}"}
    EOF
            curl -X POST -H "Content-Type: application/json" --data @payload.json "$NOTIFY_WEBHOOK"
            '''
        }
    }
}